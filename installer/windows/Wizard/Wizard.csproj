<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Cross-platform wizard core + a Windows TFM that carries the embedded webview host. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The Windows TFM transitively pulls the WindowsAppSDK MrtCore/PRI MSBuild tasks, which
         ship only with the Visual Studio toolset; no PRI resources here, so disable them
         (keeps Linux CI builds working). -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wizard.Abstractions\Wizard.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\Wizard.WebUi\Wizard.WebUi.csproj" />
  </ItemGroup>

</Project>
