<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Wordslab.Wizard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:local="using:Wordslab.Wizard.App"
        Title="Wordslab Platform — Install">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>


  <!-- The journey and web panels overlay; exactly one is visible at a time. -->
  <Grid Padding="28,20,28,20">
    <!-- The journey panel: everything a Windows user ever sees before the web handoff.
         Copy rule: written for a first-time user who has never read a word about the
         platform and is not technical. No jargon without a plain-language gloss. -->
    <Grid x:Name="JourneyPanel" MaxWidth="760" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="ms-appx:///Assets/wordslab-mark.png" Height="52" VerticalAlignment="Center" />
          <TextBlock Text="Welcome to Wordslab Platform" Style="{StaticResource TitleLargeTextBlockStyle}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                   Text="Wordslab Platform brings a personal AI into your home — an assistant and apps for you and your family that you can also understand. It is 100% open source and runs on this computer: your data stays here, the choices stay yours, and nothing happens silently or invisibly. Like the home computers of the eighties that taught a generation what a computer is, Wordslab is here to teach a generation how AI works." />
        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Wordslab runs inside a Linux virtual machine — Linux is built into Windows, and this installer turns it on for you. It prepares that machine, installs the Wordslab programs into it, and finally opens your Wordslab home page right in this window — six visible steps, nothing installed silently: press Start install and watch each one happen live below." />
      </StackPanel>

      <Border Grid.Row="1" Style="{StaticResource StepCard}" Margin="0,0,0,14">
        <StackPanel Spacing="12">
          <TextBlock Text="Where should Wordslab live?" FontWeight="SemiBold" />

          <StackPanel Spacing="4">
            <TextBlock Text="Wordslab's program folder (on Windows)" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="The Wordslab programs that run on Windows are installed in this folder." />
            <TextBox x:Name="InstallDirBox" PlaceholderText="e.g. C:\Wordslab" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Wordslab's Linux disks (one on each drive)" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Inside its Linux virtual machine, Wordslab keeps your files on Linux disks — one virtual disk file per drive in this PC. With a Linux disk on every drive, Wordslab can later store each program and your data on the drive with the most free space and the best speed. Switch off a drive you would rather not use; you can add drives later too." />
            <ItemsControl x:Name="DiskList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <!-- Classic Binding (Window root + #5902); TwoWay so the tick and folder land on the row. -->
                <DataTemplate>
                  <Grid ColumnSpacing="10" Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="250" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="{Binding DriveLabel}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Folder, Mode=TwoWay}"
                             PlaceholderText="folder for this drive's Linux disk" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock x:Name="DiskError" Visibility="Collapsed"
                     Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                     Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

          <Button x:Name="StartButton" HorizontalAlignment="Left"
                  Style="{StaticResource AccentButtonStyle}" Content="Start install"
                  Click="StartInstall_Click" MinWidth="180" Padding="24,10" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="StepsList" ItemsSource="{x:Bind Steps}">
          <!-- ItemsControl has no Spacing in WinUI; the panel (only 6 items) provides it. -->
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <!-- Classic {Binding}, not x:Bind: x:Bind WITH a converter in a Window-rooted
                 app hits microsoft-ui-xaml #5902 (generated SetConverterLookupRoot needs a
                 FrameworkElement; Window is not one). StepVm is INotifyPropertyChanged, so
                 OneWay Binding updates live exactly the same. -->
            <DataTemplate x:DataType="local:StepVm">
              <Border Style="{StaticResource StepCard}">
                <StackPanel Spacing="8">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15"
                            Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                      <TextBlock Text="{Binding NumberText}" Foreground="White" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressRing Grid.Column="2" Width="20" Height="20" IsIndeterminate="True"
                                  Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <FontIcon Grid.Column="3" Glyph="&#xE73E;" FontSize="18" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              Visibility="{Binding IsDone, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <FontIcon Grid.Column="3" Glyph="&#xE783;" FontSize="18" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              Visibility="{Binding IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                  <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                  <controls:Expander Header="output" IsExpanded="False"
                                     Visibility="{Binding HasLog, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                      <TextBlock Text="{Binding LogText, Mode=OneWay}" FontFamily="Consolas"
                                 FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                  </controls:Expander>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Spacing="8">
        <TextBlock x:Name="StatusLine" Margin="0,12,0,0" TextWrapping="Wrap"
                   Style="{StaticResource BodyTextBlockStyle}" />
        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Wordslab Platform is free and open source — github.com/wordslab-org/wordslab-platform" />
      </StackPanel>
    </Grid>

    <!-- The web handoff (phase 3): an address, not a process switch — the same window becomes
         the dashboard. A TLS error page is expected before the front door exists. -->
    <Grid x:Name="WebPanel" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="4" Margin="0,0,0,12">
        <TextBlock x:Name="WebTitle" Text="Wordslab is set up — the rest happens in your dashboard"
                   Style="{StaticResource SubtitleTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenBrowserButton" Content="Open in a web browser" Click="OpenInBrowser_Click" />
          <TextBlock x:Name="WebUrl" VerticalAlignment="Center"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
      <controls:WebView2 x:Name="Web" Grid.Row="1" />
    </Grid>
  </Grid>
</Window>
